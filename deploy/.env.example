# Production deploy environment. Copy to /opt/bookeh/.env, fill in, then
# `chmod 600 .env` (operator-owned; this one file holds every secret and path).
# Values are read as plain KEY=value lines — no quoting, escaping or $
# expansion; everything after the = is the value, verbatim.
# App-runtime variable names match the root .env.example; the deploy-only
# variables (paths, Postgres password, GHCR token, image tag) live only here.

# Postgres password for the 'bookeh' user. Also interpolated into
# DATABASE_URL, so keep it URL-safe (letters, digits, - and _).
POSTGRES_PASSWORD=CHANGE_ME

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME

# First-user seed, used only while the users table is empty. Clear both once
# the first account exists (root .env.example has the full warning).
SEED_EMAIL=
SEED_PASSWORD=

# GitHub username for `docker login ghcr.io`.
GHCR_USER=mikahimself

# Read-only GHCR token (classic PAT, scope read:packages only); README has
# the login procedure and a line to record its expiry date.
GHCR_TOKEN=CHANGE_ME

# NAS directory holding the Postgres cluster: data/ (the cluster) and the
# .bookeh-nas-mounted marker file live under it.
BOOKEH_PG_DIR=/mnt/nas/bookeh/postgres

# NAS directory for media uploads; must be owned by uid 1001 (see README).
BOOKEH_MEDIA_DIR=/mnt/nas/bookeh/media

# App image tag to run; a specific sha tag from CI pins a release.
BOOKEH_IMAGE_TAG=latest
