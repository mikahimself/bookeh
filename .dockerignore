# Keep the build context small and keep secrets and host artifacts out of the
# image. `next build` copies .env* files into .next/standalone, so .env must
# never reach the builder stage.
.env
.env.*
!.env.example
test.env

node_modules
.next
.git
.github
.vscode
.claude
