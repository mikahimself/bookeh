.dockerignore
playwright-report
test-results
media
coverage
blob-report
playwright/.cache
.DS_Store
*.pem
tests
playwright.config.ts
vitest.config.mts
vitest.setup.ts
tsconfig.tsbuildinfo
README.md
CLAUDE.md
