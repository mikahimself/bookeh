# Postgres. 'localhost' is correct when running `npm run dev` on the host
# against `docker compose up postgres`. The compose 'payload' service
# overrides this to the in-network hostname.
DATABASE_URL=postgres://bookeh:bookeh@localhost:5432/bookeh

# Directory of uploaded and downloaded media files (covers), relative to the
# working directory or absolute. Default: media
# MEDIA_DIR=media

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Dev schema push. Leave unset in dev (push stays on). CI sets it to 'false'
# for the int tests so they run on the bookeh_test schema built by migrations.
# DATABASE_PUSH=false

# Metadata sources. Unset: the real ones (Finna, then Google Books). 'fixture'
# serves tests/fixtures/finna/ instead, with covers from the app itself; refused
# under NODE_ENV=production. Playwright sets it for its own server.
# BOOKEH_SOURCES=fixture

# Next.js build directory. Default: .next. Playwright sets .next-e2e, so its
# `next dev` runs beside the usual one.
# NEXT_DIST_DIR=.next-e2e

# First-user seed: creates one admin account on start, used only while the
# users table is empty. Clear both once the first account exists: left set,
# they recreate an admin on any emptied database and keep a live password here.
SEED_EMAIL=
SEED_PASSWORD=

# Google Books API key, used by `npm run fixtures` (scripts/capture-fixtures.ts) and by the
# Google Books source, where it is optional and sent only when set.
# Keyless requests hit Google's shared daily quota (429 observed 2026-10-11).
GOOGLE_BOOKS_API_KEY=
