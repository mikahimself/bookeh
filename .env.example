# Postgres. 'localhost' is correct when running `npm run dev` on the host
# against `docker compose up postgres`. The compose 'payload' service
# overrides this to the in-network hostname.
DATABASE_URL=postgres://bookeh:bookeh@localhost:5432/bookeh

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Dev schema push. Leave unset in dev (push stays on). CI sets it to 'false'
# for the int tests so they run on the bookeh_test schema built by migrations.
# DATABASE_PUSH=false

# First-user seed: creates one admin account on start, used only while the
# users table is empty. Clear both once the first account exists: left set,
# they recreate an admin on any emptied database and keep a live password here.
SEED_EMAIL=
SEED_PASSWORD=
